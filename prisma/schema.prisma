// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  email String @unique
  first_name String
  last_name String
  password String
  instagram String
  dob DateTime
  billing_phone String
  role Role @default(customer)

  orders Order[]

  @@map("user")
  @@unique([id])
}

model Product {
  id Int @id @default(autoincrement())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  name String
  price Float
  date_time DateTime
  is_canceled Boolean @default(false)
  stock_status StockStatus @default(instock)
  category Category @relation(fields: [category_id], references: [id])
  category_id Int
  cancel String[]
  paid String[]
  pending String[]
  wait_list String[]
  confirm String[]
  stock_quantity Int @default(13)

  orders OrderProduct[]

  @@map("product")
}

model Category {
  id Int @id @default(autoincrement())

  name String
  products Product[]

  @@map("category")
}

model Report {
  id Int @id @default(autoincrement())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  date DateTime
  cash Float
  card Float
  coupons Float
  revenue Float
  profit Float
  beg Float
  beg_sum Float
  adv Float
  adv_sum Float
  students Float
  completed Boolean
  stripe String?

  costs ReportCost[]

  @@map("report")
}

model ReportCost {
  id Int @id @default(autoincrement())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  name String
  sum Float
  date DateTime

  report Report @relation(fields: [report_id], references: [id])
  report_id Int

  @@map("cost")
}

model Order {
  id Int @id @default(autoincrement())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  customer User @relation(fields: [customer_id], references: [id])
  customer_id Int
  line_items OrderProduct[]
  stripe_id String?
  date String
  payment_method PaymentMethod?
  coupons Coupon[]
  status OrderStatus
  total Float
  note String?

  @@map("order")
}

model OrderProduct {
  id Int @id @default(autoincrement())
  order Order @relation(fields: [order_id], references: [id])
  order_id Int
  product Product @relation(fields: [product_id], references: [id])
  product_id Int
  subtotal Float
  total Float
  quantity Int

  @@unique([order_id, product_id])
  @@map("order_product")
}

model Coupon {
  id Int @id @default(autoincrement())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  code String @unique
  amount Float
  discount_type DiscountType
  description String?
  date_expires DateTime?
  usage_count Int
  individual_use Boolean
  usage_limit Int
  product_categories Int[]
  exc_cat Int[]
  used_by Int[]
  allowed_users Int[]

  orders Order[]

  @@map("coupon")
}

enum DiscountType {
  percent
  fixed_cart
  fixed_product
}


enum OrderStatus {
  completed
  pending
  cancelled
  processing
}

enum PaymentMethod {
  cash
  stripe
  coupon
}

enum Role {
  administrator
  customer
}

enum StockStatus {
  instock
  outofstock
  onbackorder
}

