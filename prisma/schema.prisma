generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  email         String   @unique
  first_name    String
  last_name     String
  password      String
  instagram     String
  dob           DateTime
  billing_phone String
  removed       Boolean  @default(false)
  role          Role     @default(customer)

  orders   Order[]
  products OrderProduct[]

  used_coupons Coupon[] @relation("usedCoupons")
  coupons      Coupon[] @relation("allowedCoupons")

  wait_list Product[]

  @@unique([id])
  @@map("user")
}

model Product {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  name           String
  price          Float
  sale_price     Float?
  date_time      DateTime
  is_canceled    Boolean  @default(false)
  stock_quantity Int      @default(13)

  wait_list User[]

  orders   OrderProduct[]
  bundle   Bundle?        @relation(fields: [bundleId], references: [id])
  bundleId Int?

  categories Category[]

  @@map("product")
}

model Bundle {
  id         Int       @id @default(autoincrement())
  created_at DateTime  @default(now())
  discount   Float
  products   Product[]

  @@map("bundle")
}

model Order {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  stripe_id      String?        @unique
  payment_method PaymentMethod?
  status         OrderStatus    @default(processing)
  subtotal       Float
  total          Float
  note           String?

  line_items OrderProduct[]

  coupons Coupon[]

  customer    User @relation(fields: [customer_id], references: [id])
  customer_id Int

  @@map("order")
}

model OrderProduct {
  id Int @id @default(autoincrement())

  order    Order @relation(fields: [order_id], references: [id])
  order_id Int

  product    Product @relation(fields: [product_id], references: [id])
  product_id Int

  user    User @relation(fields: [user_id], references: [id])
  user_id Int

  productStatus ProductStatus?
  subtotal      Float
  total         Float

  @@unique([order_id, product_id, user_id])
  @@map("order_product")
}

model Coupon {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  code          String       @unique
  amount        Float
  discount_type DiscountType @default(fixed_cart)
  description   String?
  date_expires  DateTime?
  allowed_cat   Category[]

  used_by       User[] @relation("usedCoupons")
  allowed_users User[] @relation("allowedCoupons")

  orders Order[]

  @@map("coupon")
}

model Template {
  id         Int        @id @default(autoincrement())
  created_at DateTime   @default(now())
  price      Float
  name       String
  time       String
  categories Category[]

  @@map("template")
}

model Category {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now())
  name       String   @unique

  products Product[]

  templates Template[]
  coupons   Coupon[]

  @@map("category")
}

enum DiscountType {
  percent
  fixed_cart
  fixed_product
  credit
}

enum OrderStatus {
  completed
  pending
  cancelled
  processing
}

enum ProductStatus {
  confirmed
  canceled
}

enum PaymentMethod {
  cash
  stripe
  coupon
}

enum Role {
  administrator
  customer
}
