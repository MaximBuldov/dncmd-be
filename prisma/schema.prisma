// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  email String @unique
  firstName String @map("first_name")
  lastName String @map("last_name")
  password String
  instagram String
  dob DateTime
  billingPhone String @map("billing_phone")
  role Role @default(customer)

  orders Order[]

  @@map("user")
  @@unique([id])
}

model Product {
  id Int @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  name String
  price Float
  date_time String
  isCanceled Boolean @default(false) @map("is_canceled")
  stockStatus StockStatus @map("stock_status")
  category Category @relation(fields: [categoryId], references: [id])
  categoryId Int @map("category_id")
  cancel String[]
  paid String[]
  pending String[]
  wait_list String[]
  confirm String[]
  stockQuantity Int @default(13) @map("stock_quantity")

  orders OrderProduct[]

  @@map("product")
}

model Category {
  id Int @id @default(autoincrement())

  name String
  slug String @unique

  products Product[]

  @@map("category")
}

model Report {
  id Int @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  date DateTime
  cash Float
  card Float
  coupons Float
  revenue Float
  profit Float
  beg Float
  begSum Float @map("beg_sum")
  adv Float
  advSum Float @map("adv_sum")
  students Float
  completed Boolean
  stripe String?

  costs ReportCost[]

  @@map("report")
}

model ReportCost {
  id Int @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  name String
  sum Float
  date DateTime

  report Report @relation(fields: [reportId], references: [id])
  reportId Int @map("report_id")

  @@map("cost")
}

model Order {
  id Int @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer User @relation(fields: [customerId], references: [id])
  customerId Int @map("customer_id")
  items OrderProduct[]
  stripeId String? @map("stripe_id")
  date String
  paymentMethod PaymentMethod? @map("payment_method")
  coupons Coupon[]
  status OrderStatus
  total Float
  note String?

  @@map("order")
}

model OrderProduct {
  id Int @id @default(autoincrement())
  order Order @relation(fields: [orderId], references: [id])
  orderId Int @map("order_id")
  product Product @relation(fields: [productId], references: [id])
  productId Int @map("product_id")
  subtotal Float
  total Float
  quantity Int

  @@unique([orderId, productId])
  @@map("order_product")
}

model Coupon {
  id Int @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  code String @unique
  amount Float
  discountType DiscountType
  description String?
  dateExpires DateTime? @map("date_expires")
  usageCount Int
  individualUse Boolean @map("individual_use")
  usageLimit Int @map("usage_limit")
  product_categories Int[]
  exc_cat Int[]
  used_by Int[]
  allowed_users Int[]

  orders Order[]

  @@map("coupon")
}

enum DiscountType {
  percent
  fixed_cart
  fixed_product
}


enum OrderStatus {
  completed
  pending
  cancelled
  processing
}

enum PaymentMethod {
  cash
  stripe
  coupon
}

enum Role {
  administrator
  customer
}

enum StockStatus {
  instock
  outofstock
  onbackorder
}

